# Leave MONGODB_URI empty (or remove it) to use an in-memory MongoDB in development.
MONGODB_URI=mongodb://127.0.0.1:27017/juststretch
# Use a random value of at least 32 characters in production. The API refuses to start otherwise.
SESSION_SECRET=replace-with-a-32-character-random-secret
APP_URL=http://localhost:5173
TRUST_PROXY=1
PORT=3001
NODE_ENV=development

# console logs emails in development. smtp sends real mail.
MAIL_TRANSPORT=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Use a Gmail App Password, not the account password.
SMTP_PASS=
MAIL_FROM="Just Stretch <you@example.com>"

# Optional: AI wording for the dashboard's "Your progress" summary (Groq, free).
# Leave GROQ_API_KEY empty and the dashboard uses a plain template sentence instead.
# To get your own key:
#   1. Sign in at https://console.groq.com (Google or GitHub login works).
#   2. Open https://console.groq.com/keys, click "Create API Key", give it a name, copy it.
#      It starts with gsk_ and is shown only once.
#   3. Paste it below in your own server/.env (NOT in this file) and restart npm run dev.
#   4. The API log should say: [api] dashboard insight: groq (openai/gpt-oss-20b)
# Keep GROQ_MODEL as a model your key can use (llama models were not enabled on ours).
# Never commit a real key: GitHub blocks the push.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
